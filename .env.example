# ============================================================================
# t2sql environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before starting the stack:
#
#     cp .env.example .env
#
# NEVER commit the real `.env` (or `notes.txt` containing tokens).
# Rule of thumb (see t2sql CONFIG_BOUNDARY.md): if a value changes per
# environment or is a secret, it belongs here. Long phrase lists belong in
# t2sql_rules.yml, not here.
# ============================================================================

# ----------------------------------------------------------------------------
# Kafka (KRaft mode, no ZooKeeper) — required by datahub.yml
# ----------------------------------------------------------------------------
# Generate once with:
#   docker run --rm confluentinc/cp-kafka:8.0.0 /bin/kafka-storage random-uuid
KAFKA_CLUSTER_ID=<paste-uuid-from-kafka-storage>
DATAHUB_KAFKA_BROKER_PORT=9092

# ----------------------------------------------------------------------------
# Schema Registry
# ----------------------------------------------------------------------------
DATAHUB_SCHEMA_REGISTRY_PORT=8081

# ----------------------------------------------------------------------------
# Elasticsearch (DataHub search backend)
# ----------------------------------------------------------------------------
ELASTICSEARCH_HOST=elasticsearch
DATAHUB_ELASTIC_PORT=9200

# ----------------------------------------------------------------------------
# DataHub GMS / Frontend
# ----------------------------------------------------------------------------
DATAHUB_GMS_HOST=datahub-gms
DATAHUB_GMS_PORT=8080
DATAHUB_FRONTEND_PORT=9002

# Create this token in the DataHub UI (Administration → Access Tokens)
# after the stack is up, then paste it here and recreate the containers:
#   docker compose -f datahub.yml up -d --force-recreate
DATAHUB_TOKEN=<paste-token-from-datahub-ui>

# ----------------------------------------------------------------------------
# MySQL (hosts both the DataHub metadata store and the classicmodels data)
# ----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE_DATAHUB=<datahub-metadata-db-name>
MYSQL_USER=<datahub-metadata-db-user>
MYSQL_PASSWORD=<datahub-metadata-db-password>
MYSQL_ROOT_PASSWORD=<root-password>

# --- MCP server (execution boundary) ----------------------------------------
# Database the agent runs against; must be in MYSQL_ALLOWED_DATABASES.
MYSQL_DB=classicmodels
# Comma-separated allow-list of databases the MCP server may target.
# Example: classicmodels,classicmodels_2,classicmodels_3
MYSQL_ALLOWED_DATABASES=
# Safe 5x5 preview + limits (see data/python/mcp_server/mcp_server.py)
PREVIEW_ROW_LIMIT=5
PREVIEW_COL_LIMIT=5
STATEMENT_TIMEOUT_MS=5000
MAX_EXPORT_ROWS=200000

# ----------------------------------------------------------------------------
# Ollama (llm.yml)
# ----------------------------------------------------------------------------
# Models auto-pulled on container start (comma-separated).
# Default P1 preset: routing 1.5B + small 3B + large 7B + embedding model.
OLLAMA_PULL_MODELS=snowflake-arctic-embed2:568m,qwen2.5:7b-instruct,qwen2.5:3b-instruct,qwen2.5:1.5b-instruct

# ----------------------------------------------------------------------------
# MCP client / t2sql runtime (data/python/mcp_client/.env)
# ----------------------------------------------------------------------------
# --- Secrets / external services ---
DATAHUB_TOKEN=<same-token-as-above>

# --- Runtime endpoints ---
OLLAMA_URL=http://ollama:11434
MCP_BASE=http://mcp_server:8000/mcp
MCP_CLIENT_TIMEOUT=60

# --- Metadata / paths ---
CHROMA_DIR=./chroma_db
COLLECTION_NAME=<chroma-collection-name>
DENSE_METADATA_JSONL=./metadata_jsonl/classicmodels_dense.jsonl
SPARSE_METADATA_JSONL=./metadata_jsonl/classicmodels_sparse.jsonl
SCHEMA_METADATA_JSONL=
JSON_INPUT=
EXPORT_JSONL_OUTPUT=./exports_final
EXPORT_SPARSE_JSONL_OUTPUT=./exports_sparse_final

# --- Models (P1 default; scenario presets P2-P5 are defined in config.py) ---
ROUTING_MODEL=qwen2.5:1.5b-instruct
SMALL_MODEL=qwen2.5:3b-instruct
LARGE_MODEL=qwen2.5:7b-instruct
ROUTING_MODEL_P2=qwen2.5:1.5b-instruct
SMALL_MODEL_P2=qwen2.5-coder:3b
LARGE_MODEL_P2=qwen2.5-coder:7b
ROUTING_MODEL_P3=qwen2.5:1.5b-instruct
SMALL_MODEL_P3=granite-code:3b-instruct
LARGE_MODEL_P3=granite-code:8b-instruct
ROUTING_MODEL_P4=qwen2.5:1.5b-instruct
SMALL_MODEL_P4=stable-code:3b-instruct
LARGE_MODEL_P4=deepseek-coder:6.7b-instruct
ROUTING_MODEL_P5=starcoder:1b
SMALL_MODEL_P5=starcoder2:3b
LARGE_MODEL_P5=starcoder2:7b
# How long models stay resident in Ollama between calls (batch-friendly).
OLLAMA_KEEP_ALIVE=180s

# --- Key runtime flags (1 = enabled, 0 = disabled) ---
AGENT_IR_ENABLED=1
# Intent-IR lane
AGENT_IR_MIN_CONFIDENCE=0.7
AGENT_AST_GUARDS_ENABLED=1
AGENT_AST_SEMANTIC_FIRST=1
AGENT_REGEN_PRECHECK_ENABLED=1
AGENT_B4_CANNOT_ANSWER_ENABLED=1
AGENT_B4_AMBIGUITY_ABSTAIN_ENABLED=1
AGENT_B4_EVIDENCE_ABSTAIN_ENABLED=1
AGENT_PROMPT_ABSTAIN_ENABLED=1
AGENT_PROMPT_TELEMETRY=1
EXECUTION_EMPTY_RESULT_CLASSIFY=1
DOMAIN_HEURISTICS_ENABLED=1
DOMAIN_HEURISTICS_PROFILE=agnostic

# --- Retrieval (core knobs) ---
TOP_K=5
SPARSE_MAX_HITS=20
MAX_CTX_DOCS=12
SPARSE_BONUS=0.75
NAME_QUERY_BONUS=0.3
ID_QUERY_BONUS=0.4
RETRIEVE_DEBUG=1
SPARSE_DEBUG=0

# --- Evaluation / export ---
CSV_EXPORT_DIR=hitl_exports
HITL_LOG_PATH=
# Base database for VA/EX checks in batch evaluation
# (also passed explicitly via --base-database).
T2SQL_BASE_DATABASE=classicmodels

# ----------------------------------------------------------------------------
# Notes:
# - Long static lexical lists are sourced from t2sql_rules.yml.
# - Override lexical keys in .env only when you intentionally need
#   runtime-specific behavior.
# - Port 8888 (Jupyter) and 8501 (Streamlit) are published by datahub.yml.
# ============================================================================
