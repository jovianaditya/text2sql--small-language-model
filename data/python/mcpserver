FROM python:3.10-slim

# Set the working directory inside the container
WORKDIR /app

# Install necessary system packages (for psycopg2 build)
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install DataHub CLI for ingestion metadata
RUN pip install --no-cache-dir 'acryl-datahub[mysql]>=1.2.0.2'

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastmcp \
    pymysql \
    sqlparse \
    python-dotenv \
    pandas \
    numpy

# Keep the container running (for debugging / dev)
CMD ["tail", "-f", "/dev/null"]