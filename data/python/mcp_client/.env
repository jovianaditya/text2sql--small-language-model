# =========================
# Runtime Endpoints
# =========================
OLLAMA_URL=http://ollama:11434
MCP_BASE=http://mcp_server:8000/mcp
MCP_CLIENT_TIMEOUT=60

# =========================
# Metadata / Paths
# =========================
CHROMA_DIR=./chroma_db
COLLECTION_NAME=classicmodels
DENSE_METADATA_JSONL=/app/metadata_jsonl/classicmodels_dense.jsonl
SPARSE_METADATA_JSONL=/app/metadata_jsonl/classicmodels_sparse.jsonl
SCHEMA_METADATA_JSONL=/app/metadata_jsonl/classicmodels_dense.jsonl
JSON_INPUT=/app/metadata_jsonl/classicmodels_sparse.jsonl
EXPORT_JSONL_OUTPUT=/app/metadata_jsonl/classicmodels_dense.jsonl
EXPORT_SPARSE_JSONL_OUTPUT=/app/metadata_jsonl/classicmodels_sparse.jsonl

# =========================
# Models
# =========================
ROUTING_MODEL=qwen2.5:1.5b-instruct
SMALL_MODEL=qwen2.5:3b-instruct
LARGE_MODEL=qwen2.5:7b-instruct
ROUTING_MODEL_P2=qwen2.5-coder:1.5b
SMALL_MODEL_P2=qwen2.5-coder:3b
LARGE_MODEL_P2=qwen2.5-coder:7b
ROUTING_MODEL_P3=llama3.2:1b
SMALL_MODEL_P3=llama3.2:3b
LARGE_MODEL_P3=llama3.1:8b
OLLAMA_KEEP_ALIVE=180s

# =========================
# Key Runtime Flags
# =========================
AGENT_IR_ENABLED=1
AGENT_IR_MIN_CONFIDENCE=0.80
AGENT_AST_GUARDS_ENABLED=1
AGENT_AST_SEMANTIC_FIRST=1
AGENT_REGEN_PRECHECK_ENABLED=1
AGENT_B4_CANNOT_ANSWER_ENABLED=0
AGENT_B4_AMBIGUITY_ABSTAIN_ENABLED=0
AGENT_PROMPT_ABSTAIN_ENABLED=0
AGENT_PROMPT_TELEMETRY=1
EXECUTION_EMPTY_RESULT_CLASSIFY=1
DOMAIN_HEURISTICS_ENABLED=1
DOMAIN_HEURISTICS_PROFILE=agnostic

# =========================
# Retrieval (core knobs)
# =========================
TOP_K=5
SPARSE_MAX_HITS=20
MAX_CTX_DOCS=12
SPARSE_BONUS=0.75
NAME_QUERY_BONUS=0.3
ID_QUERY_BONUS=0.4
RETRIEVE_DEBUG=1
SPARSE_DEBUG=0

# =========================
# Evaluation / Export
# =========================
CSV_EXPORT_DIR=./t2sql/results/
HITL_LOG_PATH=./t2sql/reports/

# Notes:
# - Long static lexical lists are sourced from t2sql_rules.yml.
# - Override lexical keys here only when you intentionally need runtime-specific behavior.
