[REFINER - NORMALIZE] input sql:
SELECT 
    vendor, 
    CASE 
        WHEN status = 'Shipped Orders' THEN 'Shipped Orders'
        ELSE 'Other Orders'
    END AS status_group, 
    SUM(quantityOrdered) OVER (PARTITION BY vendor) AS total_quantity_ordered, 
    SUM(priceEach * quantityOrdered) OVER (PARTITION BY vendor) AS total_revenue
FROM 
    orders
INNER JOIN 
    orderdetails ON orderdetails.ordernumber = orders.orderNumber
INNER JOIN 
    products ON products.productCode = orderdetails.productCode
WHERE 
    orders.status IN ('Shipped Orders', 'Other Orders'))
GROUP BY 
    vendor, 
    CASE 
        WHEN status = 'Shipped Orders' THEN 'Shipped Orders'
        ELSE 'Other Orders'
    END
ORDER BY 
    total_revenue DESC, 
    vendor ASC, 
    status_group ASC;

